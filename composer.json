{
  "name": "revolution/niconico",
  "description": "niconico api",
  "keywords": [
    "niconico"
  ],
  "license": "MIT",
  "authors": [
    {
      "name": "kawax",
      "email": "kawaxbiz@gmail.com"
    }
  ],
  "require": {
    "php": "^8.0",
    "ext-simplexml": "*",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.0"
  },
  "require-dev": {
    "mockery/mockery": "^1.3",
    "phpunit/phpunit": "^12.0",
    "laravel/pint": "^1.25"
  },
  "autoload": {
    "psr-4": {
      "Revolution\\Niconico\\": "src/"
    }
  },
  "config": {
    "preferred-install": "dist"
  },
  "scripts": {
    "lint": [
      "vendor/bin/pint --parallel"
    ],
    "lint:check": [
      "vendor/bin/pint --parallel --test"
    ],
    "test": "vendor/bin/phpunit",
    "test:coverage": "vendor/bin/phpunit --coverage-clover build/logs/clover.xml"
  }
}
